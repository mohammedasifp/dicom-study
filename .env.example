# Orthanc / OHIF (used by the Vite dev proxy, see vite.config.js)
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=svaim
ORTHANC_PASSWORD=svaim

# dicom-study-backend (the Vite dev proxy sends /api here)
BACKEND_URL=http://localhost:4000

# Worklist data source: backend (default, dicom-study-backend), mock (in-browser data) or http (api/endpoints.js contract)
VITE_WORKLIST_SOURCE=backend

# Sign-in: backend (default with the backend worklist: backend radiologists + demo password test@123),
# mock (test accounts in data/mock/accounts.js) or http (POST /api/auth/login, once the backend has it)
VITE_AUTH_SOURCE=backend

VITE_API_BASE_URL=
VITE_MOCK_LATENCY_MS=350
